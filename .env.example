# Copy to .env and fill in. Never commit the real .env.

# --- Interactive Brokers (TWS / IB Gateway) ---
# Requires a running TWS or IB Gateway. Use a PAPER account for research.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = paper TWS, 7496 = live TWS, 4002 = paper Gateway
IBKR_CLIENT_ID=1

# --- News / event data provider (Model 3, optional) ---
NEWS_API_KEY=

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=./mlruns
